Options -MultiViews
RewriteEngine On

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

RewriteRule ^server(?:/|$) - [F,L,NC]
RewriteRule ^api/(?:bootstrap|migrate|router)\.php$ - [F,L,NC]
RewriteRule ^api/?$ api/index.php [QSA,END]
RewriteRule ^api/ api/index.php [QSA,END]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.html [L]
