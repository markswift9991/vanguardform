# Local Vite development proxies /api requests to the PHP development server.
API_SERVER_URL=http://127.0.0.1:8000

# Aiven PostgreSQL connection. These server-only values must not use a VITE_ prefix.
PGHOST=pg-9588700-allenpeterson516-efd7.f.aivencloud.com
PGPORT=25042
PGDATABASE=defaultdb
PGUSER=avnadmin
PGPASSWORD=replace-with-your-rotated-password
PG_CA_CERT_PATH=server/certs/aiven-ca.pem

# Required to encrypt Telegram bot credentials before storing them in PostgreSQL.
# Generate once with: openssl rand -base64 32
# Keep the same key permanently and back it up securely; do not commit it.
TELEGRAM_SETTINGS_ENCRYPTION_KEY=replace-with-a-random-base64-32-byte-key